  m_text: "\u0414\u043E\u0441\u0442\u0443\u043F \u0440\u0430\u0437\u0440\u0435\u0448\u0451\u043D.
    \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0442\u043E\u0447\u043D\u044B\u0435
    \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B \u0434\u043B\u044F
    \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0438 \u0441\u043F\u0430\u0441\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043C\u043E\u0434\u0443\u043B\u044F. \u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430:
    \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u044B
    \u043D\u0430 \u0440\u0443\u0447\u043D\u043E\u043C \u043C\u0430\u044F\u0447\u043A\u0435
    \u0433\u0434\u0435-\u0442\u043E \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C."
